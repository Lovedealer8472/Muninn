# Muninn / pantanakerfi environment (copy to .env)

SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0
BEHIND_PROXY=1

# Auth (optional bcrypt hashes; defaults: admin / user)
# STJORI_PASSWORD_HASH=
# NOTANDI_PASSWORD_HASH=
# ADMIN_PASSWORD_HASH=

# Features
PWA_ENABLED=1
DETAIL_INLINE_EDIT=1

# Trial (optional — omit on production instances like th.tolvuhvislarinn.is)
# TRIAL_EXPIRES_AT=2026-06-07

# Public sandbox (demo.tolvuhvislarinn.is)
# DEMO_MODE=1

# Public tracking URL (optional override)
# TRACK_PUBLIC_URL=https://th.tolvuhvislarinn.is

# Shop branding
SHOP_NAME=Verslunin
# SHOP_PHONE=
# SHOP_URL=https://tolvuhvislarinn.is

# SMTP (customer notifications)
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@tolvuhvislarinn.is
